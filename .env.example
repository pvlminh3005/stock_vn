# ==============================================================
# Stock RT - File Mẫu Cấu Hình Môi Trường (.env.example)
# Sao chép file này thành envs/.env.development hoặc envs/.env.production
# ==============================================================

# Định danh môi trường: development | production | testing
APP_ENV=development

# Cấu hình Telegram Bot Alert
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id
APP_PUBLIC_URL=http://localhost:8000
APP_ACCESS_PIN=

# Danh sách Whitelist Host miễn kiểm tra mã PIN (cách nhau bằng dấu phẩy)
WHITELIST_HOSTS=localhost,127.0.0.1

# Cấu hình MongoDB Atlas Cloud
# Môi trường Dev và Prod phân tách an toàn thông qua MONGODB_URI riêng biệt của từng cụm Cluster.
# Tên Database được thống nhất là stock_pro_db.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=stock_pro_db

# Thời gian tự động dọn dẹp các lệnh đã bán/chốt (Mặc định 180 ngày = 6 tháng)
PORTFOLIO_RETENTION_DAYS=180
