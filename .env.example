# Cấu hình Telegram Bot Alert
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id
APP_PUBLIC_URL=
APP_ACCESS_PIN=

# Danh sách Whitelist Host miễn kiểm tra mã PIN (cách nhau bằng dấu phẩy)
WHITELIST_HOSTS=

# Cấu hình MongoDB (Tùy chọn: nếu để trống sẽ tự động dùng SQLite local)
# Ví dụ MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=stock_pro_db
# Thời gian tự động dọn dẹp các lệnh đã bán/chốt (Mặc định 180 ngày = 6 tháng)
PORTFOLIO_RETENTION_DAYS=180
